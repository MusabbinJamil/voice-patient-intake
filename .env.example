# Copy to .env for local dev. NEVER commit the real .env.
# In production (Render) set these in the dashboard, not in a file.

# Postgres connection string from Neon (production).
# Leave unset locally to use a zero-setup SQLite file (sqlite:///./patients.db).
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Shared secret Vapi sends in the x-vapi-secret header. Generate a long random
# string and paste the SAME value into each Vapi tool's server.secret.
VAPI_SHARED_SECRET=change-me-to-a-long-random-string

# Seed 1-2 demo patients on first boot (table empty only). true/false.
SEED_ON_STARTUP=true

APP_ENV=development
